# BETTERGOV Chain Environment Configuration Template
# Copy to .env for local development. Never commit real private keys or API secrets.

BETTERGOV_ENV=devnet
BETTERGOV_COSMOS_CHAIN_ID=bettergov-devnet-1
BETTERGOV_EVM_CHAIN_ID=31337
BETTERGOV_RPC_URL=http://127.0.0.1:8545
BETTERGOV_WS_URL=ws://127.0.0.1:8546
BETTERGOV_PRIVATE_ADMIN_RPC=http://127.0.0.1:26657

# Backend & Indexer
PORT=4000
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=bettergov
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=bettergov_indexer

# Optional Local AI Provider for ai-security (Keyless Ollama / LM Studio compatible)
TEMPEST_LOCAL_BASE_URL=http://127.0.0.1:11434/api
TEMPEST_LOCAL_MODEL=llama3

